WMS_SQL_PORT=1433
# αν το IT δώσει named instance (π.χ. SERVER\SQLEXPRESS), βάλε εδώ μόνο το SQLEXPRESS
WMS_SQL_INSTANCE=
WMS_SQL_DATABASE=
WMS_SQL_USER=
WMS_SQL_PASSWORD=
WMS_SQL_ENCRYPT=false
WMS_SQL_TRUST_CERT=true

