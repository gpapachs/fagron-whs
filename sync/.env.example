# Fagron WHS -- ρυθμίσεις συγχρονισμού αποθέματος
# Αντέγραψε σε rythmiseis.txt (ή .env) στον ίδιο φάκελο και συμπλήρωσε. Δεν ανεβαίνει στο GitHub.

# ---- SQL του WMS (από το IT, λογαριασμός ΜΟΝΟ ανάγνωσης)
WMS_SQL_SERVER=192.168.1.22
# named instance (192.168.1.22\SQLEXPRESS): η θύρα βρίσκεται αυτόματα
WMS_SQL_INSTANCE=SQLEXPRESS
# μόνο αν το IT δώσει σταθερή θύρα (τότε άδειασε το WMS_SQL_INSTANCE)
WMS_SQL_PORT=
WMS_SQL_DATABASE=
WMS_SQL_USER=
WMS_SQL_PASSWORD=
WMS_SQL_ENCRYPT=false
WMS_SQL_TRUST_CERT=true

